{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "moduleSuffixes": [".web", ""],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["app/components/*"],
      "@utils/*": ["app/utils/*"],
      "@cuptrail/core": ["../../packages/core"],
      "@cuptrail/core/*": ["../../packages/core/*"],
      "@cuptrail/utils": ["../../packages/utils"],
      "@cuptrail/utils/*": ["../../packages/utils/*"],
      "@cuptrail/maps": ["../../packages/maps"],
      "@cuptrail/maps/*": ["../../packages/maps/*"]
    }
  },
  "include": ["app"],
  "exclude": ["node_modules", "dist"],
}
